# Local dev: npm run server (fixed port 5000, 127.0.0.1)
# Production: npm run backend (uses PORT below, default 8000, host 0.0.0.0)
PORT=8000

# Contact storage backend: postgresql | firebase | indexeddb
# Set to indexeddb when using VITE_CONTACT_STORAGE=indexeddb (browser-only contacts)
CONTACT_STORAGE=indexeddb

DATABASE_URL=postgresql://user:password@localhost:5432/cardsync

# Required when CONTACT_STORAGE=firebase
FIREBASE_CREDENTIALS_PATH=
# Optional
FIREBASE_STORAGE_BUCKET=

# Frontend must match backend storage mode (postgresql | firebase | indexeddb)
# VITE_CONTACT_STORAGE=indexeddb

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE_CODE=
WHATSAPP_SCAN_TEMPLATE_NAME=cardsync_scan_thanks

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: enable Google Vision OCR for better extraction accuracy.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
