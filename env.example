# Copy to .env and fill in secrets (never commit .env)

# --- Production (Render + Netlify) ---
PRODUCTION_API_URL=https://business-card-scanner-2.onrender.com
NETLIFY_SITE_URL=https://businesscardscannertesting.netlify.app
FRONTEND_URL=https://businesscardscannertesting.netlify.app
ALLOWED_ORIGINS=https://businesscardscannertesting.netlify.app

# --- Frontend (Vite / Netlify) ---
VITE_API_URL=https://business-card-scanner-2.onrender.com
# VITE_API_URL=http://localhost:5000

VITE_CONTACT_STORAGE=indexeddb
LOCAL_DB_PORT=3001
VITE_LOCAL_DB_URL=http://localhost:3001

# --- Python backend (local: PORT=5000, Render: PORT from platform) ---
APP_ENV=development
PORT=5000
CONTACT_STORAGE=indexeddb

DATABASE_URL=postgresql://user:password@localhost:5432/cardsync

FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=
